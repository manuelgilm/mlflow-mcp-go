mlflow.db
mlruns/
mlartifacts/
*.sqlite
*.sqlite3
*.db

# --- Docker -----------------------------------------------------------------
docker-compose.override.yml
.dockerignore.local
*.tar
# Keep .dockerignore committed; it belongs in the repo.

