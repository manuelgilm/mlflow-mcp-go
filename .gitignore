# --- Go ---------------------------------------------------------------------
# Compiled binaries (never commit these)
/bin/
/mlflow-mcp
/mlflow-mcp-go
/cmd/mlflow-mcp/mlflow-mcp
*.exe
*.dll
*.so
*.dylib

# Test / coverage output
*.test
*.out
coverage.*
profile.cov

# Build & tooling caches
/vendor/
*.prof
# go.sum is committed on purpose: it pins the SDK and its transitives.

# --- Python (MLflow fixture) ------------------------------------------------
