.venv/
venv/
env/
.venv*/

# Bytecode
__pycache__/
*.py[cod]
*$py.class

# Packaging / test artifacts
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

